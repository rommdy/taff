  };

  return (
    <View>
      <TextInput
        placeholder="Nom d'utilisateur"
        onChangeText={setUsername}
        value={username}
      />
      <TextInput
        placeholder="Mot de passe"
        secureTextEntry
        onChangeText={setPassword}
        value={password}
      />
      <Button title="Se Connecter" onPress={handleLogin} />
    </View>
  );
};

export default LoginScreen;


